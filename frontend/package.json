{
  "name": "web-agent-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env ELECTRON_FORCE_DEV=1 concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build --mode electron",
    "electron:start": "electron .",
    "desktop": "npm run electron:dev"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.56.2",
    "lucide-react": "^1.34.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.4",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "vite": "^8.1.0",
    "wait-on": "^8.0.1"
  }
}
